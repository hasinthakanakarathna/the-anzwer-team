# Copy to .env and fill in before deploying.
NODE_ENV=production
SESSION_SECRET=replace-with-a-long-random-string
PORT=3000
COMPANY_TIMEZONE=Asia/Colombo

# Firebase / Firestore (required)
FIREBASE_PROJECT_ID=your-project-id
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxxxx@your-project-id.iam.gserviceaccount.com
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"

# Google Drive chat archives (required for 7-day wipe)
# 1) Enable Google Drive API on the Firebase project
# 2) Create a Drive folder and share it with FIREBASE_CLIENT_EMAIL (Editor)
# 3) Paste that folder ID below
GOOGLE_DRIVE_FOLDER_ID=
GOOGLE_DRIVE_SHARE_EMAIL=xapple200100@gmail.com
CHAT_RETENTION_DAYS=7
